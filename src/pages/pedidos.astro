---
// Ruta protegida: lista SOLO los pedidos del usuario con sesión
// (la autorización la aplica el resolver `misPedidos`, no la página).
import Layout from '../layouts/Layout.astro';
import { ejecutar } from '../server/gql.js';

const user = Astro.locals.user!;
const { misPedidos } = await ejecutar(
  `{
    misPedidos {
      id total subtotal envio estado fechaCreacion metodoPago
      detalles { cantidad subtotal producto { nombre } }
    }
  }`,
  {},
  user
);
const mxn = (n: number) => `$${n.toFixed(2)}`;
---
<Layout title="Mis pedidos — FitStock">
  <section class="section">
    <h2>Mis pedidos</h2>

    {misPedidos.length === 0 ? (
      <div class="empty-state">
        <p>Aún no tienes pedidos.</p>
        <a class="btn btn-secondary" href="/" style="text-decoration:none">Ver catálogo</a>
      </div>
    ) : (
      misPedidos.map((p) => (
        <article class="order-card">
          <div class="order-head">
            <strong>Pedido #{p.id}</strong>
            <span class="badge">{p.estado}</span>
            <span style="color:var(--color-text-dim)">{p.fechaCreacion} · {p.metodoPago}</span>
          </div>
          <div style="margin:12px 0">
            {p.detalles.map((d) => (
              <div class="order-line">
                <span>{d.producto.nombre} × {d.cantidad}</span>
                <span>{mxn(d.subtotal)}</span>
              </div>
            ))}
          </div>
          <div class="order-line"><span>Envío</span><span>{p.envio === 0 ? 'Gratis' : mxn(p.envio)}</span></div>
          <div class="order-line" style="color:var(--color-text);font-weight:700">
            <span>Total</span><span>{mxn(p.total)} MXN</span>
          </div>
        </article>
      ))
    )}
  </section>
</Layout>
