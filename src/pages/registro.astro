---
import Layout from '../layouts/Layout.astro';
import { rutaSegura } from '../server/auth.js';

const q = Astro.url.searchParams;
const error = q.get('error');
const nombre = q.get('nombre') ?? '';
const email = q.get('email') ?? '';
const next = rutaSegura(q.get('next') ?? '/');
---
<Layout title="Crear cuenta — FitStock">
  <div class="auth-wrap">
    <form class="auth-card" method="POST" action="/api/auth/register">
      <h1>Crear cuenta</h1>
      <p class="sub">Regístrate para comprar y dar seguimiento a tus pedidos.</p>

      {error && <div class="auth-error" role="alert">{error}</div>}

      <input type="hidden" name="next" value={next} />

      <div class="auth-field">
        <label for="nombre">Nombre completo</label>
        <input id="nombre" name="nombre" required minlength="2" value={nombre} autocomplete="name" />
      </div>
      <div class="auth-field">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" required value={email} autocomplete="email" />
      </div>
      <div class="auth-field">
        <label for="password">Contraseña (mín. 8, letras y números)</label>
        <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" />
      </div>
      <div class="auth-field">
        <label for="confirm">Confirmar contraseña</label>
        <input id="confirm" name="confirm" type="password" required minlength="8" autocomplete="new-password" />
      </div>

      <button class="btn btn-primary" type="submit" style="width:100%">Crear cuenta</button>

      <p class="auth-alt">¿Ya tienes cuenta? <a href={`/login?next=${encodeURIComponent(next)}`}>Iniciar sesión</a></p>
    </form>
  </div>
</Layout>
