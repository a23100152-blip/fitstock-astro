# URL del backend GraphQL independiente (carpeta ../back). En desarrollo
# local, el backend corre en el puerto 4000 por defecto.
BACKEND_URL=http://localhost:4000

# Mercado Pago — LLAVE PÚBLICA (Public Key) de tus credenciales de prueba: empieza con "TEST-".
# Es pública (va al navegador, para los campos seguros de la tarjeta). El Access Token NUNCA va aquí: va en back/.env.
# Si la dejas vacía, el formulario funciona en modo demostración (no cobra nada).
PUBLIC_MP_PUBLIC_KEY=
