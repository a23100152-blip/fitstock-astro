---
// Gráfica de área/línea en SVG puro (sin librerías): se dibuja en el servidor, cero JavaScript en el navegador.
// Pasa el cursor sobre un punto para ver el detalle (<title> nativo).
interface Punto { etiqueta: string; valor: number; detalle: string }
interface Props { datos: Punto[]; formatoEje: (n: number) => string }
const { datos, formatoEje } = Astro.props;

const W = 760, H = 280;
const M = { t: 16, r: 16, b: 34, l: 62 };
const iw = W - M.l - M.r, ih = H - M.t - M.b;

// Tope "redondo" del eje Y (1, 2, 5 × 10^n) para que las líneas guía queden en cifras limpias.
const maxReal = Math.max(...datos.map((d) => d.valor), 0);
function topeBonito(v: number) {
  if (v <= 0) return 100;
  const exp = Math.pow(10, Math.floor(Math.log10(v)));
  const f = v / exp;
  return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10) * exp;
}
const tope = topeBonito(maxReal);
const marcas = [0, 0.25, 0.5, 0.75, 1].map((p) => ({ y: M.t + ih - p * ih, valor: tope * p }));

const n = datos.length;
const x = (i: number) => M.l + (n === 1 ? iw / 2 : (i / (n - 1)) * iw);
const y = (v: number) => M.t + ih - (v / tope) * ih;

const puntos = datos.map((d, i) => `${x(i).toFixed(1)},${y(d.valor).toFixed(1)}`);
const linea = `M ${puntos.join(' L ')}`;
const area = `${linea} L ${x(n - 1).toFixed(1)},${M.t + ih} L ${x(0).toFixed(1)},${M.t + ih} Z`;

const cadaN = Math.max(1, Math.ceil(n / 8));
const mostrarPuntos = n <= 45;
---
<svg viewBox={`0 0 ${W} ${H}`} class="chart-svg" role="img" aria-label="Ventas por día">
  <defs>
    <linearGradient id="relleno-ventas" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ff4425" stop-opacity="0.45" />
      <stop offset="100%" stop-color="#ff4425" stop-opacity="0.02" />
    </linearGradient>
  </defs>

  {marcas.map((m) => (
    <>
      <line x1={M.l} x2={W - M.r} y1={m.y} y2={m.y} stroke="#2c2c2c" stroke-width="1" />
      <text x={M.l - 8} y={m.y + 4} text-anchor="end" class="chart-eje">{formatoEje(m.valor)}</text>
    </>
  ))}

  {datos.map((d, i) => (i % cadaN === 0 || i === n - 1) && (
    <text x={x(i)} y={H - 10} text-anchor="middle" class="chart-eje">{d.etiqueta}</text>
  ))}

  <path d={area} fill="url(#relleno-ventas)" />
  <path d={linea} fill="none" stroke="#ff4425" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />

  {datos.map((d, i) => (
    <circle cx={x(i)} cy={y(d.valor)} r={mostrarPuntos ? (d.valor > 0 ? 3.5 : 2) : 6} fill={d.valor > 0 ? '#ff4425' : '#1e1e1e'} stroke="#ff4425" stroke-width="1.5" class="chart-punto" opacity={mostrarPuntos || d.valor > 0 ? 1 : 0}>
      <title>{d.etiqueta}: {d.detalle}</title>
    </circle>
  ))}
</svg>
