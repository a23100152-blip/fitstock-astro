---
// Layout.astro — Esqueleto reutilizable (TopBar + Sidebar + Footer).
// Es HTML estático renderizado en el servidor; solo el carrito y los toasts
// son islas de React. La sesión viene de Astro.locals (la pone el middleware).
import '../styles/global.css';
import CartWidget from '../components/CartWidget.jsx';
import ToastHost from '../components/ToastHost.jsx';
import { backendGraphQL } from '../lib/backend.js';

interface Props { title?: string }
const { title = 'FitStock — Suplementos, ropa y accesorios' } = Astro.props;

const user = Astro.locals.user;
const { categorias } = await backendGraphQL('{ categorias { id nombre icono } }');
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="app-shell">
      <header class="topbar">
        <a class="topbar-brand" href="/">💪 FitStock</a>
        <div class="topbar-actions">
          {user ? (
            <>
              <span class="topbar-user">Hola, {user.nombre.split(' ')[0]}</span>
              {user.rol === 'admin' && <a class="topbar-link topbar-link-admin" href="/admin">📊 Panel admin</a>}
              <a class="topbar-link" href="/pedidos">Mis pedidos</a>
              <a class="topbar-link" href="/cuenta">Mi cuenta</a>
              <form class="inline-form" method="POST" action="/api/auth/logout">
                <button class="link-button" type="submit">Cerrar sesión</button>
              </form>
            </>
          ) : (
            <>
              <a class="topbar-link" href="/login">Iniciar sesión</a>
              <a class="topbar-link" href="/registro">Crear cuenta</a>
            </>
          )}
          <CartWidget client:only="react" />
        </div>
      </header>

      <div class="layout">
        <aside class="sidebar">
          <p class="sidebar-title">Categorías</p>
          {categorias.map((cat) => (
            <a
              class:list={['sidebar-item', { active: path === `/categoria/${cat.id}` }]}
              href={`/categoria/${cat.id}`}
            >
              <span>{cat.icono}</span>
              <span>{cat.nombre}</span>
            </a>
          ))}
        </aside>

        <main class="main"><slot /></main>
      </div>

      <footer class="footer">
        <span>© 2026 FitStock — Proyecto integrador</span>
        <span>Programación Web 2 · Migración a Astro</span>
      </footer>
    </div>

    <div id="modal-root"></div>
    <ToastHost client:only="react" />
  </body>
</html>
