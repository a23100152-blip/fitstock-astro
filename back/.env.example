# Copia este archivo como ".env" (en la carpeta back/) y llénalo.
# Sin credenciales, PayPal y Mercado Pago funcionan en MODO SIMULADO (pantalla de pago de demostración).
# Con credenciales de prueba (sandbox) hablan con las pasarelas de verdad.

PORT=4000
# URL pública del frontend: a donde las pasarelas regresan al cliente después de pagar.
FRONT_URL=http://localhost:4321
CORS_ORIGIN=http://localhost:4321

# --- PayPal (https://developer.paypal.com → Apps & Credentials → pestaña Sandbox) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Mercado Pago (https://www.mercadopago.com.mx/developers → Tus integraciones → Credenciales de prueba) ---
MP_ACCESS_TOKEN=

# --- Opcionales ---
PAGOS_MONEDA=MXN
# Minutos que se reserva el stock de un pedido de PayPal/Mercado Pago sin pagar antes de cancelarlo
PAGO_TIMEOUT_MIN=30
# Zona horaria para agrupar las ventas por día en el dashboard (México centro = -6)
TZ_OFFSET_HORAS=-6
